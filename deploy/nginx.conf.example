# 김포과기고 EBS 입반 신청
# /etc/nginx/sites-available/ebs-apply 로 복사한 뒤 도메인을 바꾸고 링크하세요.
# 애플리케이션은 127.0.0.1:3100 한 포트에서 화면과 API를 함께 제공합니다.

server {
    listen 80;
    server_name apply.example.com;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # 앞단 프록시가 이 nginx뿐이라면 클라이언트 주소를 그대로 넘깁니다.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# HTTPS는 certbot --nginx -d apply.example.com 으로 붙이면 됩니다.
# 인증서를 켠 뒤 앱 환경변수 COOKIE_SECURE=1 을 설정하세요.
